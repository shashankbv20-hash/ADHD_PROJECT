# Copy to backend/.env for local development; never commit backend/.env.
# Use Firebase Application Default Credentials or an approved workload identity.
FIREBASE_PROJECT_ID=adhd-bf37a
FIRESTORE_DATABASE_ID=(default)
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# Hardening (see docs/deployment.md). Set ENVIRONMENT=production behind HTTPS to send HSTS.
# ENVIRONMENT=development
# MAX_REQUEST_BYTES=262144
# RATE_LIMIT_PER_MINUTE=240        # per authenticated caller; 0 disables
# RATE_LIMIT_IP_PER_MINUTE=600     # per client address; 0 disables
# TRUST_PROXY_HEADERS=false        # true only behind a proxy that overwrites X-Forwarded-For

# Optional: set FIRESTORE_EMULATOR_HOST only when the Firestore Emulator is running.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# Optional auth emulator for local ID-token testing; not used by unit tests.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
