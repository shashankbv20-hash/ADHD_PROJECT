# Public values are embedded by Next.js at build time. Demo mode is the default.
NEXT_PUBLIC_DATA_PROVIDER=demo

# Leave blank for demo mode. Example placeholder for a future local backend;
# no backend server or endpoint contract is implemented in this project.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=

# Firebase Web App configuration only. These are public browser values, not secrets.
# Set NEXT_PUBLIC_DATA_PROVIDER=firebase only after copying values from the
# intended Firebase project's Web App settings.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
