# Public values are embedded by Next.js at build time. Demo mode is the default.
NEXT_PUBLIC_DATA_PROVIDER=demo

# Backend (FastAPI) origin, without /api/v1. Used by remote mode and, optionally,
# by firebase mode: when set there, scored CPT runs are saved through the API
# (after explicit research consent) instead of directly to Firestore.
# Leave blank to keep the Firebase-only behavior. Example for local development:
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=

# Firebase Web App configuration only. These are public browser values, not secrets.
# Set NEXT_PUBLIC_DATA_PROVIDER=firebase only after copying values from the
# intended Firebase project's Web App settings.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Live end-to-end tests only (npm run test:e2e:live). Connects the browser to the local Firebase
# emulators. Ignored unless the project ID starts with "demo-" and the hosts are loopback.
# NEXT_PUBLIC_FIREBASE_EMULATORS=1
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# NEXT_PUBLIC_FIREBASE_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
