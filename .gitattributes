# Store text as LF in the repository and check it out as LF on every platform, so Windows
# and macOS/Linux contributors do not produce whole-file line-ending diffs.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files: never convert or diff as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.pth binary
*.pt binary
*.onnx binary
*.zip binary
